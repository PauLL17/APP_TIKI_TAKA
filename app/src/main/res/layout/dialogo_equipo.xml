<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etNombreEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nombre_equipo"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etCiudadEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ciudad"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etEstadioEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_estadio"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etEntrenadorEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_entrenador"
        android:inputType="text"/>
    
    <EditText
        android:id="@+id/etEscudoUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_escudo_url"
        android:inputType="textUri"
        android:layout_marginBottom="12dp"/>

</LinearLayout>